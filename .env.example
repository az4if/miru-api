# ====================== Basic Configuration ======================

# Port the server listens on (most PaaS override this automatically)
PORT=8080

# Optional API key protection
# Leave empty to disable authentication (open to everyone)
# Set a strong secret if you want to protect the API
API_KEY=

# Rate limiting (requests per minute per IP)
# Set to 0 to disable rate limiting
RATE_LIMIT_RPM=120

# ====================== Caching ======================

# Default cache TTL for most endpoints
CACHE_DEFAULT_TTL=10m

# ====================== Upstream Settings ======================

# Timeout for normal JSON API calls to the upstream backend
UPSTREAM_TIMEOUT=15s

# Base URL of the upstream backend
UPSTREAM_BASE=https://animetsu.live/v2

# Base URL for HLS proxy (used when rewriting playlists)
HLS_PROXY_BASE=https://animetsu.live

# Headers sent to upstream
UPSTREAM_REFERER=https://animetsu.live/
UPSTREAM_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/147.0.0.0 Safari/537.36

# ====================== Logging ======================

# Log level: trace, debug, info, warn, error
LOG_LEVEL=info
